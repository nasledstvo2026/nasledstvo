{% extends "base.html.j2" %}
{% block content %}
<div class="slide">
  <div class="slide-title">{{ title }}</div>
  <div class="decor-line"></div>

  {% set cols = 4 %}
  <div style="display: flex; flex-wrap: wrap; margin-top: 28px; padding: 0;">
    {% for m in metrics %}
    <div style="width: 274px; height: 130px; background: var(--bg-card); border-radius: var(--radius-card);
                padding: 18px 16px; box-shadow: var(--shadow-card); text-align: center;
                border-top: 3px solid {{ m.color | default('var(--accent)') }};
                margin-right: {{ '20px' if (loop.index % cols) != 0 else '0' }};
                margin-bottom: {{ '16px' if (loop.index <= cols) or (metrics|length > cols and loop.index <= cols*2) else '0' }};">
      <div style="font-size: 34px; font-weight: 800; color: {{ m.color | default('var(--accent)') }};
                  line-height: 1.1; margin-bottom: 8px;">
        {{ m.value }}
      </div>
      <div style="font-size: 10px; color: var(--text-muted); line-height: 1.4;">
        {{ m.label }}
      </div>
    </div>
    {% endfor %}
  </div>

  {% if note %}
  <div style="margin-top: 16px; font-size: 9px; color: var(--text-muted); text-align: center;">
    {{ note }}
  </div>
  {% endif %}

  <div class="footer">
    <span>{{ footer | default('Отдел сопровождения дирекции радиоэлектроники') }}</span>
    <span class="page-num">{{ page_num }}</span>
  </div>
</div>
{% endblock %}
