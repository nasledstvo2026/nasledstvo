{% extends "base.html.j2" %}
{% block content %}
<div class="slide">
  <div class="slide-title">{{ title }}</div>
  <div class="decor-line"></div>

  <div class="flex-row" style="height: 400px; align-items: center;">
    <div style="flex: 1; padding-right: 30px;">
      <div style="font-size: 26px; font-weight: 300; color: var(--text-primary); line-height: 1.3; margin-bottom: 28px;">
        {{ tagline }}
      </div>
      {% for line in contacts %}
      <div style="font-size: var(--body); color: var(--text-muted); margin-bottom: 10px;">
        {{ line }}
      </div>
      {% endfor %}
    </div>

    <div style="flex: 1; background: var(--accent); border-radius: var(--radius-card); padding: 44px 36px;
                box-shadow: var(--shadow-card); display: flex; flex-direction: column; justify-content: center;
                align-items: center; text-align: center;">
      <div style="font-size: 26px; font-weight: 700; color: var(--text-primary); line-height: 1.3; margin-bottom: 14px;">
        {{ cta | default('ГОТОВЫ ОБЕСПЕЧИТЬ ВАШ ЗАПРОС') }}
      </div>
      <div style="font-size: 16px; font-weight: 400; color: rgba(255,255,255,0.85);">
        {{ cta_sub | default('В день обращения') }}
      </div>
    </div>
  </div>

  <div class="footer">
    <span>{{ footer | default('Отдел сопровождения дирекции радиоэлектроники') }}</span>
    <span class="page-num">{{ page_num }}</span>
  </div>
</div>
{% endblock %}
